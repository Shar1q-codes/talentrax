# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# Keep the documented env template in version control.
!.env.example

# Source documents for the insights import. The client's bundle also holds
# internal planning documents that must never be committed; the importer
# reads the .docx files from wherever they are unpacked (see
# scripts/import-articles.ts) and only the generated content is tracked.
*.docx
/*.zip
