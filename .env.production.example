# The variables a hosted build needs, with no values. Nothing here is ever
# filled in and committed: set them per context on the deploy platform
# (Netlify: Site configuration > Environment variables), and in CI before
# `next build`.
#
# The NEXT_PUBLIC_* ones are inlined by `next build` and must be present in
# the BUILD environment. Setting them at runtime afterwards does nothing - it
# takes another build. See .env.local.example for what each one drives.
#
# With APP_ENV staging or production, the build and server refuse to start if
# NEXT_PUBLIC_SUPABASE_URL points at localhost or 127.0.0.1. The Supabase pair
# is not needed for the build to succeed: the client checks it when it is
# first constructed, not at build time.

# Which environment this is: staging or production. Set it in the deploy
# environment and nowhere else - never in .env.local. Unset means
# local, which switches the localhost refusal off. A value outside
# local | staging | production refuses to start.
APP_ENV=

# e.g. https://www.talentraxglobal.com - absolute origin, no trailing slash.
NEXT_PUBLIC_SITE_URL=

# The hosted project's URL, from its dashboard (Project Settings > API).
# Staging and production are different projects with different values.
NEXT_PUBLIC_SUPABASE_URL=

# The hosted project's publishable key (Project Settings > API Keys,
# sb_publishable_...). Never a secret key.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# The hosted project's secret key (Project Settings > API Keys,
# sb_secret_...). A real secret: it acts as service_role and bypasses RLS.
# RUNTIME, not build: no NEXT_PUBLIC_ prefix, read on the server only, by
# src/lib/supabase/admin.ts and by the staff sign-in calls to Auth
# (auth-fetch.ts). On Netlify, mark it secret and scope it to Functions so
# the build never sees it.
SUPABASE_SECRET_KEY=
