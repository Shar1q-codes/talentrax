# Copy to .env.local for local overrides, and set in the deploy environment.

# Absolute origin, no trailing slash. Drives metadataBase, every canonical URL,
# robots.txt and sitemap.xml. Falls back to http://localhost:3000 when unset,
# so builds and local dev work without it.
NEXT_PUBLIC_SITE_URL=https://www.talentraxglobal.com
